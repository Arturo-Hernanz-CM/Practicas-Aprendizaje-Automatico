      "outputs": [],
      "source": [
        "random_search_svm_radial = RandomizedSearchCV(clf_svm_r,\n",
        "                              param_grid,\n",
        "                              scoring='balanced_accuracy',\n",
        "                              cv=inner,\n",
        "                              n_jobs=-1,\n",
        "                              verbose=1,\n",
        "                              n_iter=20,\n",
        "                              random_state=100495850\n",
        "                             )"
