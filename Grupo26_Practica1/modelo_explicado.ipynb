      "source": [
        "cat_transformer = Pipeline(steps=[\n",
        "    ('imputer', SimpleImputer(strategy='most_frequent')),\n",
        "    ('onehot', OneHotEncoder(handle_unknown='ignore', sparse_output=False)),\n",
        "    ('pca', PCA(n_components=5))\n",
        "])\n",
        "cat_transformer[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "D8s4o5UTZk1n"
      },
      "source": [
        "Vamos a evaluar el efecto de las diferentes combinaciones de escalado (minmax, standard, robust), de imputador (media y mediana) y de nÃºmero de folds:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 21,
      "metadata": {
        "id": "Km4-CpC8flDU"
      },
      "outputs": [],
      "source": [
        "scalers = {\n",
        "    'MinMax': MinMaxScaler(),\n",
        "    'Standard': StandardScaler(),\n",
        "    'Robust': RobustScaler()\n",
        "}\n",
        "\n",
        "imputers = {\n",
        "    'Mean': SimpleImputer(strategy='mean'),\n",
        "    'Median': SimpleImputer(strategy='median')\n",
        "}\n",
        "#inner = KFold(n_splits=5, shuffle=True, random_state=100495850)\n",
        "\n",
        "# Guardar resultados para la grafica\n",
        "knn_results_balanced = {}\n",
        "knn_results_unbalanced = {}\n",
        "\n",
        "# Iterar sobre cada nÃºmero de folds en la validaciÃ³n cruzada\n",
        "for fold in range(2, 11):\n",
        "    inner =  StratifiedKFold(n_splits=fold, shuffle=True, random_state=100495850)   # Se usa stratifiedKfold debido a que los datso estÃ¡n desequilibrados\n",
        "\n",
        "    for scaler_name, scaler in scalers.items():\n",
        "        for imputer_name, imputer in imputers.items():\n",
        "\n",
        "            num_transformer = Pipeline(steps=[\n",
        "                ('imputer', imputer),\n",
        "                ('scaler', scaler)\n",
        "            ])\n",
        "\n",
        "            preprocessor = ColumnTransformer(transformers=[\n",
        "                ('num', num_transformer, num_cols),\n",
        "                ('cat', cat_transformer, cat_cols)\n",
        "            ])\n",
        "\n",
        "            pipeline = Pipeline(steps=[\n",
        "                ('preprocessor', preprocessor),\n",
        "                ('knn', KNeighborsClassifier(n_neighbors=5))\n",
        "            ])\n",
        "\n",
        "            score_bal = cross_val_score(pipeline, X_train, y_train, cv=inner, scoring='balanced_accuracy').mean()\n",
        "            score_unbal = cross_val_score(pipeline, X_train, y_train, cv=inner, scoring='accuracy').mean()\n",
        "\n",
        "            key = f\"{scaler_name} + {imputer_name}\"\n",
        "            if key not in knn_results_balanced:\n",
        "                knn_results_balanced[key] = []\n",
        "            knn_results_balanced[key].append((fold, score_bal))\n",
        "\n",
        "            if key not in knn_results_unbalanced:\n",
        "                knn_results_unbalanced[key] = []\n",
        "            knn_results_unbalanced[key].append((fold, score_unbal))"
      ]
    },
