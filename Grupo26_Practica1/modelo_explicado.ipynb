      "cell_type": "code",
      "execution_count": 132,
      "metadata": {
        "id": "t7WWMM4CiCdx"
      },
      "outputs": [],
      "source": [
        "param_grid = {  'svc__C': [0.001, 0.01, 1, 10, 100, 1000, 100000],\n",
        "                'svc__gamma': ['scale', 0.1, 0.01, 0.001, 0.0001, 0.00001],\n",
        "                'preprocessor__cat__pca__n_components': list(range(1, 10))\n",
        "                }"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 133,
      "metadata": {
        "id": "_GutMsKAiCdy"
