      "source": [
        "cat_transformer = Pipeline(steps=[\n",
        "    ('imputer', SimpleImputer(strategy='most_frequent')),\n",
        "    ('onehot', OneHotEncoder(handle_unknown='ignore', sparse_output=False)),\n",
        "    ('pca', PCA(n_components=5))\n",
        "])\n",
        "cat_transformer[0]"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Y_bnmsRHRjhl"
      },
      "source": [
        "En cuanto a balnced_accuracy, podemos ver que la peor combinaciÃ³n es RobustScaler con la mediana, sin embargo, como comentaba antes esto se debe a la gran cantidad de outliers.\n",
        "Por ello usaremos la RobustScaler con la mediana con 8 folds (mejor resultado)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 54,
      "metadata": {
        "id": "ugKuBntkRjhn"
      },
      "outputs": [],
      "source": [
        "scalers = {\n",
        "    'MinMax': MinMaxScaler(),\n",
        "    'Standard': StandardScaler(),\n",
        "    'Robust': RobustScaler()\n",
        "}\n",
        "\n",
        "imputers = {\n",
        "    'Mean': SimpleImputer(strategy='mean'),\n",
        "    'Median': SimpleImputer(strategy='median')\n",
        "}\n",
        "\n",
        "# Guardar resultados para la grÃ¡fica\n",
        "tree_results_balanced = {}\n",
        "tree_results_unbalanced = {}\n",
        "\n",
        "# Iterar sobre cada nÃºmero de folds en la validaciÃ³n cruzada\n",
        "for fold in range(2, 11):\n",
        "    inner = StratifiedKFold(n_splits=fold, shuffle=True, random_state=100495850)\n",
        "\n",
        "    for scaler_name, scaler in scalers.items():\n",
        "        for imputer_name, imputer in imputers.items():\n",
        "\n",
        "            num_transformer = Pipeline(steps=[\n",
        "                ('imputer', imputer),\n",
        "                ('scaler', scaler)\n",
        "            ])\n",
        "\n",
        "            preprocessor = ColumnTransformer(transformers=[\n",
        "                ('num', num_transformer, num_cols),\n",
        "                ('cat', cat_transformer, cat_cols)\n",
        "            ])\n",
        "\n",
        "            pipeline = Pipeline(steps=[\n",
        "                ('preprocessor', preprocessor),\n",
        "                ('classifier', tree.DecisionTreeClassifier(class_weight='balanced', random_state=100495850))\n",
        "            ])\n",
        "\n",
        "            score_bal = cross_val_score(pipeline, X_train, y_train, cv=inner, scoring='balanced_accuracy').mean()\n",
        "            score_unbal = cross_val_score(pipeline, X_train, y_train, cv=inner, scoring='accuracy').mean()\n",
        "\n",
        "            key = f\"{scaler_name} + {imputer_name}\"\n",
        "            if key not in tree_results_balanced:\n",
        "                tree_results_balanced[key] = []\n",
        "            tree_results_balanced[key].append((fold, score_bal))\n",
        "\n",
        "            if key not in tree_results_unbalanced:\n",
        "                tree_results_unbalanced[key] = []\n",
        "            tree_results_unbalanced[key].append((fold, score_unbal))"
      ]
    },
