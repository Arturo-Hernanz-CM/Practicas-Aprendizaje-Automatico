        "# Definir el modelo dummy con la estrategia mÃ¡s frecuente\n",
        "dummy_clf = DummyClassifier(strategy=\"most_frequent\")  # Siempre predice la clase mayoritaria\n",
        "dummy_clf.fit(X_train, y_train)  # Entrenar (solo guarda la clase mÃ¡s frecuente)\n",
        "\n",
        "# Hacer predicciones\n",
        "y_pred = dummy_clf.predict(X_test)\n",
        "bal_acc = balanced_accuracy_score(y_test, y_pred)\n",
        "result = metrics.classification_report(y_test, y_pred, zero_division=1)\n",
        "resultados[\"Dummy\"] = {\"Resultado\": result, \"Tiempo\": 0, \"Balanced Accuracy\": bal_acc,  \"Notas\": \"No se buscan hpo\"}\n",
