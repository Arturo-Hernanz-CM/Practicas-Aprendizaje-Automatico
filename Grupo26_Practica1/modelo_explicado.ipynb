      "source": [
        "# Convierte los resultados de la bÃºsqueda en DataFrame\n",
        "results_df = pd.DataFrame(grid_search_knn.cv_results_)\n",
        "\n",
        "# Selecciona solo los hiperparÃ¡metros y la mÃ©trica de rendimiento\n",
        "hpo_cols = ['param_preprocessor__cat__pca__n_components',\n",
        "            'param_knn__n_neighbors',\n",
        "            'param_knn__weights',\n",
        "            'param_knn__metric']\n",
        "results_hpo = results_df[hpo_cols + ['mean_test_score']].copy()\n",
        "\n",
        "for col in hpo_cols:\n",
        "    if results_hpo[col].dtype == 'object':\n",
        "        results_hpo.loc[:, col] = LabelEncoder().fit_transform(results_hpo[col])\n",
        "\n",
        "# Calcula la correlaciÃ³n entre hiperparÃ¡metros y rendimiento\n",
        "correlation = results_hpo.corr()['mean_test_score'].drop('mean_test_score')\n",
        "\n",
        "#GrÃ¡fico de Barras: Importancia de los HPO en el rendimiento\n",
        "plt.figure(figsize=(8, 5))\n",
        "correlation.abs().sort_values().plot(kind='barh', color='royalblue')\n",
        "plt.xlabel(\"CorrelaciÃ³n Absoluta con Mean Test Score\")\n",
        "plt.title(\"Influencia de los HiperparÃ¡metros en el Rendimiento del Modelo\")\n",
        "plt.grid(axis='x', linestyle='--', alpha=0.7)\n",
        "plt.show()"
      ]
    },
