        "svm_model_r = clf_svm_r.fit(X_train, y_train)\n",
        "y_pred_svm_r = svm_model_r.predict(X_test)\n",
        "\n",
        "print(f\"Balanced Accuracy: {balanced_accuracy_score(y_test, y_pred_svm_r)}\")\n",
        "print(\"Classification Report:\")\n",
        "print(classification_report(y_test, y_pred_svm_r))"
      ]
    },
