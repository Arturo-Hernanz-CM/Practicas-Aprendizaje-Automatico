        "plt.figure(figsize=(15, 10))\n",
        "\n",
        "# GrÃ¡fico balanced accuracy:\n",
        "for key, values in knn_results_balanced.items():\n",
        "    folds, scores = zip(*values)  # Extraer datos\n",
        "    plt.plot(folds, scores, marker='o', label=key)  # Graficar lÃ­nea con puntos\n",
        "\n",
        "plt.xlabel(\"NÃºmero de folds (KFold)\")\n",
        "plt.ylabel(\"Balanced Accuracy\")\n",
        "plt.title(\"EvoluciÃ³n de Balanced Accuracy con distintos Folds y Preprocesamiento\")\n",
        "plt.legend(title=\"MÃ©todos\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(15, 10))\n",
        "# GrÃ¡fico accuracy\n",
        "for key, values in knn_results_unbalanced.items():\n",
        "    folds, scores = zip(*values)  # Extraer datos\n",
        "    plt.plot(folds, scores, marker='o', label=key)  # Graficar lÃ­nea con puntos\n",
        "\n",
        "plt.xlabel(\"NÃºmero de folds (KFold)\")\n",
        "plt.ylabel(\"Accuracy\")\n",
        "plt.title(\"EvoluciÃ³n de Accuracy con distintos Folds y Preprocesamiento\")\n",
        "plt.legend(title=\"MÃ©todos\")\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
